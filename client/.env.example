# In development, Vite proxies /api → localhost:5000 automatically (see vite.config.js)
# In production, set this to your deployed backend URL:
# VITE_API_URL=https://vibely-api.vercel.app/api

# EmailJS : used by the forgot-password page to send real reset emails
# Get these from https://www.emailjs.com/
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key